enhance the application by implementing the following features:

Reset Confirmation: Display a confirmation dialog before resetting the daily water intake.
Input Validation: Prevent the user from entering negative or zero water values.
Entry Count: Display the total number of water intake entries recorded today.
Remaining Water: Display the amount of water remaining to reach the daily goal.
Completion Percentage: Display the percentage of the daily water goal completed.

Example: If the daily goal is 2000 mL and the user enters 500 mL + 250 mL + 750 mL:
Total consumed = 1500 mL
Remaining = 500 mL
Entries = 3
Completion = 75%


import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';

void main() {
  runApp(const WaterApp());
}

class WaterApp extends StatelessWidget {
  const WaterApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'HydroTrack',
      theme: ThemeData(
        useMaterial3: true,
        colorSchemeSeed: Colors.blue,
        scaffoldBackgroundColor: const Color(0xffF5FAFF),
      ),
      home: const HomePage(),
    );
  }
}

class HomePage extends StatefulWidget {
  const HomePage({super.key});

  @override
  State<HomePage> createState() => _HomePageState();
}

class _HomePageState extends State<HomePage> {
  int water = 0;
  int goal = 2000;
  int entries = 0;

  @override
  void initState() {
    super.initState();
    loadData();
  }

  // Load saved data
  Future<void> loadData() async {
    final prefs = await SharedPreferences.getInstance();

    setState(() {
      water = prefs.getInt('water') ?? 0;
      goal = prefs.getInt('goal') ?? 2000;
      entries = prefs.getInt('entries') ?? 0;
    });
  }

  // Add water
  Future<void> addWater(int amount) async {
    if (amount <= 0) return;

    final prefs = await SharedPreferences.getInstance();

    setState(() {
      water += amount;
      entries++;
    });

    await prefs.setInt('water', water);
    await prefs.setInt('entries', entries);
  }

  // Set new goal
  Future<void> setGoal(int newGoal) async {
    if (newGoal <= 0) return;

    final prefs = await SharedPreferences.getInstance();

    setState(() {
      goal = newGoal;
    });

    await prefs.setInt('goal', newGoal);
  }

  // Reset all data
  Future<void> resetWater() async {
    final prefs = await SharedPreferences.getInstance();

    setState(() {
      water = 0;
      entries = 0;
    });

    await prefs.setInt('water', 0);
    await prefs.setInt('entries', 0);
  }

  // Custom water dialog
  void showWaterDialog() {
    final controller = TextEditingController();

    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: const Text(
            'Add Water',
            style: TextStyle(fontWeight: FontWeight.bold),
          ),
          content: TextField(
            controller: controller,
            keyboardType: TextInputType.number,
            decoration: InputDecoration(
              labelText: 'Amount in ml',
              hintText: 'Example: 300',
              prefixIcon: const Icon(Icons.water_drop),
              border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(12),
              ),
            ),
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(context);
              },
              child: const Text('Cancel'),
            ),
            ElevatedButton(
              onPressed: () {
                final amount = int.tryParse(controller.text);

                // Validation
                if (amount == null || amount <= 0) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(
                      content: Text(
                        'Please enter a valid amount greater than 0 ml',
                      ),
                    ),
                  );
                  return;
                }

                addWater(amount);
                Navigator.pop(context);
              },
              child: const Text('Add'),
            ),
          ],
        );
      },
    );
  }

  // Goal dialog
  void showGoalDialog() {
    final controller = TextEditingController(
      text: goal.toString(),
    );

    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: const Text(
            'Set Daily Goal',
            style: TextStyle(fontWeight: FontWeight.bold),
          ),
          content: TextField(
            controller: controller,
            keyboardType: TextInputType.number,
            decoration: InputDecoration(
              labelText: 'Daily goal in ml',
              hintText: 'Example: 2000',
              prefixIcon: const Icon(Icons.flag),
              border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(12),
              ),
            ),
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(context);
              },
              child: const Text('Cancel'),
            ),
            ElevatedButton(
              onPressed: () {
                final newGoal = int.tryParse(controller.text);

                if (newGoal == null || newGoal <= 0) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(
                      content: Text(
                        'Goal must be greater than 0 ml',
                      ),
                    ),
                  );
                  return;
                }

                setGoal(newGoal);
                Navigator.pop(context);
              },
              child: const Text('Save'),
            ),
          ],
        );
      },
    );
  }

  // Reset confirmation
  void showResetDialog() {
    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: const Text('Reset Water Intake?'),
          content: const Text(
            'Are you sure you want to reset today\'s water intake?',
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(context);
              },
              child: const Text('Cancel'),
            ),
            ElevatedButton(
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.red,
                foregroundColor: Colors.white,
              ),
              onPressed: () {
                resetWater();
                Navigator.pop(context);
              },
              child: const Text('Reset'),
            ),
          ],
        );
      },
    );
  }

  Widget waterButton(
    String title,
    IconData icon,
    int? amount,
  ) {
    return SizedBox(
      height: 65,
      child: ElevatedButton(
        onPressed: () {
          if (amount != null) {
            addWater(amount);
          } else {
            showWaterDialog();
          }
        },
        style: ElevatedButton.styleFrom(
          backgroundColor: Colors.white,
          foregroundColor: Colors.blue,
          elevation: 2,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(16),
          ),
        ),
        child: Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(icon),
            const SizedBox(width: 8),
            Text(
              title,
              style: const TextStyle(
                fontWeight: FontWeight.bold,
              ),
            ),
          ],
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    // Calculate progress
    double progress = water / goal;

    if (progress > 1) {
      progress = 1;
    }

    // Calculate percentage
    int percentage = ((water / goal) * 100).round();

    if (percentage > 100) {
      percentage = 100;
    }

    // Calculate remaining water
    int remaining = goal - water;

    if (remaining < 0) {
      remaining = 0;
    }

    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'HydroTrack 💧',
